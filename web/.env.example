# ---- Public (exposed to the browser; NEXT_PUBLIC_ prefix) ----
# Production origin used for canonical URLs, hreflang, Open Graph, robots.txt and sitemap.xml.
# Must be the real domain in production (not localhost or a preview URL).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# Sub-path the site is served from, e.g. /immigration_law_firm_project for a GitHub Pages
# project site. Leave empty for a domain root. The deploy workflow sets this automatically.
NEXT_PUBLIC_BASE_PATH=

# Set to true for demo/preview deployments so search engines don't index them.
NEXT_PUBLIC_NOINDEX=
