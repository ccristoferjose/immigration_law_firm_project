# ---- Public (exposed to the browser; NEXT_PUBLIC_ prefix) ----
# Production origin used for canonical URLs, hreflang, Open Graph, robots.txt and sitemap.xml.
# Must be the real domain in production (not localhost or a preview URL).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# ---- Server-only (never exposed to the browser) ----
# Where contact form submissions are POSTed as JSON (e.g. Zapier/Make/Formspree webhook).
# Required in production; without it the form shows an error asking visitors to call.
CONTACT_WEBHOOK_URL=
